                        "type": "string"
                    },
                    "example": {
                        "\"description\"": "\"must be valid UUID\"}",
                        "{\"field\"": "\"user_id\""
                    }
                },
                "message": {
                    "type": "string",
                    "example": "invalid request"
                },
                "reason": {
                    "type": "string",
